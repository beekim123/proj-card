definition = {"id":"mon_dragon","phase":1,"group":"怪","viewBox":"0 0 520 400","load":"inline","monster":"boss","anchor":[260,400],"hitPoint":[260,230],"parts":["root","shadow","pile","tail","body","belly_gems","wings","head","jaw","eyes","face_hurt","face_daze"],"events":{"hit":400,"hit_big":700,"attack":800,"daze":600,"die":1000,"layer":800},"stay":["daze"],"desc":"宝石龙（首领）：一条胖胖的龙趴在一堆宝石上，肚皮上嵌着三颗大宝石（红圆、绿方、蓝三角），小翅膀、卷尾巴、两只角、睡不醒的厚眼皮。只有宝石鲜艳发亮，龙身压暗。不喷火（不要火光），出手是扑上来咬、喷一团宝石碎屑。【第二版】动法按第二版规则（美术包需求.md 第 2 节）：同一动作所有部件同一时间点换姿势；待机顺滑呼吸、不用 steps()；受击 50ms 到位、停 80ms、250ms 弹回带一次过头；出手蓄力 250ms → 80ms 扑出（第 330ms 咬中）→ 停到 450ms → 退回。整只怪的位移、放大扑向镜头由代码做，画里每一帧都不出画框。新事件 layer（血掉一层、换规矩时播）：龙抬头吼一声，肚皮上的三颗宝石依次闪一下，0.8 秒。","status":"返修","v2":"第2批","artStyle":"fable-carbon-remake","idle":true}
