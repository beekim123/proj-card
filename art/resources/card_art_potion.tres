definition = {"group":"额外牌原画","viewBox":"0 0 176 188","load":"inline","events":{"play":600},"status":"新画法重制","id":"card_art_potion","batch":"本体第2批","desc":"药水（回 1 颗心，用过就没了）：一只圆肚旧玻璃药瓶，软木塞，瓶里是红宝石色的液体（红 #E3263A 附近，是画里唯一鲜艳的东西），瓶颈挂一块小木牌（不写字）。待机：液面轻轻晃。play：塞子\"啵\"地弹起来，一颗红色心形的光从瓶口冒出来往上飘、淡出，液面降到瓶底（播完回到待机：满瓶）","idle":true,"production_note":"画法、时间点与静态例外以本包需求.md/制作规范.md/动作时间表.json为准。","artStyle":"fable-carbon-remake"}
