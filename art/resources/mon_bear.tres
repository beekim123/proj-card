definition = {"id":"mon_bear","phase":1,"group":"怪","viewBox":"0 0 320 400","load":"inline","monster":"normal","anchor":[160,400],"hitPoint":[160,250],"parts":["root","shadow","body","head","ear","arms","gem","face","face_hurt","face_daze","stuffing"],"events":{"hit":400,"hit_big":700,"attack":800,"daze":600,"die":1000},"stay":["daze"],"desc":"布偶熊（小怪）：一只缝过很多次的旧布偶熊，掉了一只耳朵（剩缝线），眼睛是两种不一样的缝线，怀里死死抱着一颗切好的红宝石。被重击时缝线崩开、飞出棉花（不是血）。【第二版】动法按第二版规则（美术包需求.md 第 2 节）：同一动作所有部件同一时间点换姿势；待机顺滑呼吸、不用 steps()；受击 50ms 到位、停 80ms、250ms 弹回带一次过头；出手蓄力 250ms → 80ms 扑出（第 330ms 咬中）→ 停到 450ms → 退回。整只怪的位移、放大扑向镜头由代码做，画里每一帧都不出画框。规矩「抱红」：怀里那颗红宝石要一直看得见、比现在再大一点；受击时熊把宝石抱得更紧（手臂收一下），不松手。","status":"返修","v2":"第2批"}
