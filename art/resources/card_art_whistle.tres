definition = {"id":"card_art_whistle","group":"额外牌原画","viewBox":"0 0 176 188","load":"inline","events":{"play":600},"desc":"哨子（从牌堆里叫来 1 张额外牌）：一只旧铜哨，哨身嵌一颗黄色宝石（黄 = 红 + 绿）。待机：哨子轻轻晃。play：哨子一吹（哨口冒出三道短弧线），一张额外牌的牌背从画框下沿飞上来，停在哨子旁边，再落回去","status":"新画法重制","batch":"本体第2批","idle":true,"production_note":"画法、时间点与静态例外以本包需求.md/制作规范.md/动作时间表.json为准。","artStyle":"fable-carbon-remake"}
