definition = {"group":"怪","viewBox":"0 0 320 400","load":"inline","monster":"normal","anchor":[160,400],"stay":["daze"],"status":"新画法重制","id":"mon_lock","hitPoint":[160,230],"batch":"本体第2批","parts":["root","shadow","body","shackle","keyhole","eyes","face_hurt","face_daze","bolts"],"events":{"hit":400,"hit_big":700,"attack":800,"daze":600,"die":1000,"click":250,"shut":500},"desc":"大挂锁（第二幕精英）：一把比人还高的旧铁挂锁，长廊尽头宝库门上的那把。锁身（body）厚重，铆钉一圈；锁梁（shackle）是头顶一个大 U 形铁环；锁身正面的钥匙孔（keyhole）就是它的嘴；钥匙孔上方两颗铆钉是眼睛（eyes）。冷灰铁色，有锈斑。规矩\"限六张\"：每回合最多打 6 张牌。click（250，你每打一张牌播）：锁芯\"咔\"一声，锁身往下一顿，钥匙孔里闪一下。shut（500，打到第 6 张时播）：锁梁猛地往下扣死，整把锁一震，\"这回合不能再打了\"","idle":true,"production_note":"画法、时间点与静态例外以本包需求.md/制作规范.md/动作时间表.json为准。","artStyle":"fable-carbon-remake"}
