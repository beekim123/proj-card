definition = {"id":"card_art_stone","phase":1,"group":"额外牌原画","viewBox":"0 0 176 188","load":"inline","events":{"play":600},"desc":"磨石（三颗宝石各长 5 次）：小木架上一只圆磨石轮，带摇把。要一眼看出「磨宝石、让宝石长大」：轮上正压着一颗宝石在磨，磨的地方迸出光，旁边摆着磨亮了的红、绿、蓝三颗小宝石。待机：轮子慢转、宝石边上偶尔闪一下。play：飞快地转，三颗小宝石依次亮起变大一圈","status":"新画法重制","v2":"第1批","idle":true,"production_note":"画法、时间点与静态例外以本包需求.md/制作规范.md/动作时间表.json为准。","artStyle":"fable-carbon-remake"}
