definition = {"id":"npc_knocker","group":"角色","viewBox":"0 0 240 240","load":"inline","idle":true,"anchor":[120,120],"parts":["root","plate","face","eyes","mouth","ring"],"events":{"talk":1200},"desc":"老门环：大门上的一只旧铜门环，会说话，话多、爱打赌，诡萌不吓人。一块圆形铜底板（plate），上面是一张老头脸（face）：粗眉毛、圆鼻子、两只小眼睛（eyes），嘴（mouth）里叼着一只大铜环（ring），铜环垂在下巴下面。铜是压暗的旧铜色，不发光；眼睛里各一点很小的绿宝石色，是唯一鲜艳的地方。待机：铜环极慢地左右晃（3 秒一轮），偶尔眨眼。talk：嘴一张一合 4 次，铜环跟着上下颠，眉毛挑一下，1.2 秒，播完回到待机。它只出现在开局选宝物的画面左上角，显示出来大约 150 像素宽","status":"新画","batch":"本体第1批","artStyle":"fable-carbon-remake"}
