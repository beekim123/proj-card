definition = {"id":"mon_soldier","phase":1,"group":"怪","viewBox":"0 0 320 400","load":"inline","monster":"normal","anchor":[160,400],"hitPoint":[160,230],"parts":["root","shadow","legs","body","head","jaw","key","spear","face_hurt","face_daze","spring"],"events":{"hit":400,"hit_big":700,"attack":800,"daze":600,"die":1000,"unwind":300,"wound_down":600},"stay":["daze","wound_down"],"desc":"发条兵（小怪）：一个铁皮玩具兵，圆筒身子、高帽子、大方下巴，背后插一把发条钥匙一直在转，手里一杆长枪。动作一顿一顿的。死的时候弹簧、齿轮崩出来，整个倒下。【第二版】动法按第二版规则（美术包需求.md 第 2 节）：同一动作所有部件同一时间点换姿势；待机顺滑呼吸、不用 steps()；受击 50ms 到位、停 80ms、250ms 弹回带一次过头；出手蓄力 250ms → 80ms 扑出（第 330ms 咬中）→ 停到 450ms → 退回。整只怪的位移、放大扑向镜头由代码做，画里每一帧都不出画框。规矩「上发条」：背后的钥匙就是发条。unwind（你打出带蓝的牌时播）：钥匙倒着转四分之一圈，身子一歪，0.3 秒。wound_down（松完 4 圈，这次出手作废）：钥匙停住、身子垮下来、枪尖垂到地上，0.6 秒进场后一直保持，直到下回合代码去掉。","status":"返修","v2":"第2批"}
