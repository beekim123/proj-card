definition = {"group":"宝物","viewBox":"0 0 192 192","load":"img","status":"新画法重制","id":"relic_biggem","batch":"本体第3批","desc":"大宝石：古堡里最大的那颗宝石，龙肚子里那颗。一颗多切面的大白宝石（白 = 三色混合），切面里透出红、绿、蓝三色的光，嵌在一只旧金爪托上。通关画面放大显示，收藏室里缩到 96。画框 192×192，比别的宝物大一倍","idle":true,"production_note":"画法、时间点与静态例外以本包需求.md/制作规范.md/动作时间表.json为准。","artStyle":"fable-carbon-remake"}
