definition = {"id":"loot_chest","phase":2,"group":"界面","viewBox":"0 0 240 200","load":"inline","anchor":[120,200],"events":{"drop":500,"open":800},"stay":["open"],"desc":"战利品宝箱：小一号的精致宝箱，铜包角，锁扣上三颗小宝石（和宝箱怪要一眼分开：这个是死的、干净的）。待机：偶尔轻轻一颠。drop：从上面掉下来弹一下。open：箱盖打开，冒出一小团三色碎光，然后停在打开的样子","status":"已有"}
