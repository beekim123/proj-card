definition = {"id":"card_art_bag","phase":1,"group":"额外牌原画","viewBox":"0 0 176 188","load":"inline","events":{"play":600},"desc":"口袋（摸 2 张）：一只旧皮口袋，袋口的扣子是一颗绿色方宝石。从原画上要一眼看出「摸 2 张」：袋口敞开，露出两张牌背的上半截（牌背照 card_back 的样子缩小）。待机：两张牌在袋口一起一伏。play：两张牌在画框内从袋口弹起，250ms到最高且完整在框内，400ms保持，600ms回到袋口静止；全程不出画框","status":"新画法重制","v2":"第1批","idle":true,"production_note":"画法、时间点与静态例外以本包需求.md/制作规范.md/动作时间表.json为准。","artStyle":"fable-carbon-remake"}
