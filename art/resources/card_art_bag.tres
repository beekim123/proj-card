definition = {"id":"card_art_bag","phase":1,"group":"额外牌原画","viewBox":"0 0 176 188","load":"inline","events":{"play":600},"desc":"口袋（摸 2 张）：一只旧皮口袋，袋口的扣子是一颗绿色方宝石。【第二版重画】从原画上要一眼看出「摸 2 张」：袋口敞开，露出两张牌背的上半截（牌背照 card_back 的样子缩小）。待机：两张牌在袋口一起一伏。play：两张牌一前一后从袋里弹出来、飞出画框上沿","status":"重画","v2":"第1批"}
