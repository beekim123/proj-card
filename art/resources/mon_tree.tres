definition = {"group":"怪","viewBox":"0 0 320 400","load":"inline","monster":"normal","anchor":[160,400],"stay":["daze"],"status":"新画法重制","id":"mon_tree","hitPoint":[160,220],"batch":"本体第3批","parts":["root","shadow","pot","trunk","branches","coins","eyes","face_hurt","face_daze","coins_fall"],"events":{"hit":400,"hit_big":700,"attack":800,"daze":600,"die":1000,"regrow":800},"desc":"摇钱树（第三幕小怪）：一棵种在旧陶盆（pot）里的小铜树。树干（trunk）是扭着长的旧铜，树干上两个树洞是眼睛（eyes）；枝条（branches）上挂的叶子是一枚枚旧金币（coins，压暗的旧金，不发光），中间夹着几颗小宝石。规矩\"长回去\"：回合结束时，这回合掉的血长回一半。regrow（800，长回去时播）：树干一挺，掉了的金币叶一片片从枝头冒出来、长大","idle":true,"production_note":"画法、时间点与静态例外以本包需求.md/制作规范.md/动作时间表.json为准。","artStyle":"fable-carbon-remake"}
