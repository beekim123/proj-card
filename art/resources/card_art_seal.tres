definition = {"id":"card_art_seal","group":"额外牌原画","viewBox":"0 0 176 188","load":"inline","events":{"play":600},"desc":"封条（这回合怪的规矩不算）：一块旧木牌子（怪头顶挂的规矩牌子那种），上面斜贴着两条交叉的旧纸封条，交叉的地方盖一个蜡印，牌子上原来的字被盖住。这张牌没有宝石，画面里不出现宝石色。待机：封条的一个角轻轻翘起又落下。play：两条封条和蜡印先弹起来离开牌子，再一条、两条啪啪拍回去，蜡印最后按下","status":"新画法重制","batch":"本体第1批","idle":true,"production_note":"画法、时间点与静态例外以本包需求.md/制作规范.md/动作时间表.json为准。","artStyle":"fable-carbon-remake"}
