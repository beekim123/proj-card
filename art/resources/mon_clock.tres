script = ExtResource("1")
art_id = "mon_clock"
svg_fingerprint = "abc60781828e55ee"
definition = {"id":"mon_clock","phase":1,"group":"怪","viewBox":"0 0 320 400","load":"inline","monster":"normal","anchor":[160,400],"hitPoint":[160,210],"parts":["root","shadow","case","dial","hand_hour","hand_minute","pendulum","eyes","face_hurt","face_daze","gears","countdown_slot"],"events":{"hit":400,"hit_big":700,"attack":800,"daze":600,"die":1000,"tick":500,"ring":400},"stay":["daze"],"slots":{"countdown_slot":[160,140,64]},"desc":"老座钟（精英）：一座高高的落地钟，表盘就是脸（表盘上方两扇小窗是眼睛），肚子里的玻璃后面钟摆在晃。表盘中心必须在 (160,140)、半径约 56：代码把倒计时数字写在表盘正中（countdown_slot），所以表盘中间要空、要浅。tick = 倒计时少 1 时指针跳一下、钟身一震。【第二版】动法按第二版规则（美术包需求.md 第 2 节）：同一动作所有部件同一时间点换姿势；待机顺滑呼吸、不用 steps()；受击 50ms 到位、停 80ms、250ms 弹回带一次过头；出手蓄力 250ms → 80ms 扑出（第 330ms 咬中）→ 停到 450ms → 退回。整只怪的位移、放大扑向镜头由代码做，画里每一帧都不出画框。新事件 ring（规矩「敲钟」：你凑白时播）：整座钟往上一顿、钟身一震，表盘上方冒出两圈声波弧线，0.4 秒。和 tick（指针跳一下）要一眼分得开。","status":"返修","v2":"第2批"}
