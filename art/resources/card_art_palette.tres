definition = {"group":"额外牌原画","viewBox":"0 0 176 188","load":"inline","events":{"play":600},"status":"新画","id":"card_art_palette","tint":true,"batch":"本体第2批","desc":"调色盘（跟上一张的颜色，一定算顺色，还给顺色链补上一种缺的颜色）：一块旧木调色盘，上面五团\"颜料\"其实是五小堆宝石碎；还有一个空着的凹坑。用 currentColor 画一层宝石光（代码按上一张牌的混色染）；五堆宝石碎本身是固定的红、黄、绿、青、蓝。待机：宝石碎微微闪。play：一支旧画笔从右上角伸进来，在空凹坑里点一下，凹坑里长出一堆品红宝石碎，闪一下，画笔收回","artStyle":"fable-carbon-remake","idle":true}
