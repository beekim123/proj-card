definition = {"group":"怪","viewBox":"0 0 320 400","load":"inline","monster":"normal","anchor":[160,400],"stay":["daze"],"status":"新画法重制","id":"mon_armor","hitPoint":[160,180],"batch":"本体第3批","parts":["root","shadow","legs","body","helmet","visor","eyes","shield","sword","face_hurt","face_daze","plates"],"events":{"hit":400,"hit_big":700,"attack":800,"daze":600,"die":1000,"cap":500},"desc":"盔甲（第三幕精英）：一副空的旧骑士盔甲自己站着。头盔（helmet）的面罩（visor）缝里两点很小的绿宝石色光是眼睛（eyes，唯一鲜艳的地方，不发大光）；左手一面大圆盾（shield），右手一把长剑（sword）拄在地上。冷灰铁色，有凹痕和锈。规矩\"压倍率\"：倍率最高到 ×32。cap（500，倍率到顶时播）：盔甲举起盾往下一压，\"当\"一声，整副盔甲往下一沉","idle":true,"production_note":"画法、时间点与静态例外以本包需求.md/制作规范.md/动作时间表.json为准。","artStyle":"fable-carbon-remake"}
