definition = {"id":"card_art_shadow","group":"额外牌原画","viewBox":"0 0 176 188","load":"inline","events":{"play":600},"desc":"影子（跟上一张一模一样：宝石一样，反应也一样）：一张立着的旧牌（牌背朝外，看不到牌面），身后地上拖着一个和它一模一样的黑影。待机：黑影轻轻晃，像烛光下的影子。play：黑影从地上立起来，变成第二张一模一样的牌，和前面那张并排站一下，再躺回地上。黑影是近黑的冷灰，不是纯黑","status":"新画法重制","batch":"本体第2批","idle":true,"production_note":"画法、时间点与静态例外以本包需求.md/制作规范.md/动作时间表.json为准。","artStyle":"fable-carbon-remake"}
