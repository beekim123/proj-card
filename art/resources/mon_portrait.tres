definition = {"group":"怪","viewBox":"0 0 320 400","load":"inline","monster":"normal","anchor":[160,400],"stay":["daze"],"status":"新画","id":"mon_portrait","hitPoint":[160,190],"batch":"本体第2批","parts":["root","shadow","legs","frame","canvas","figure","eyes","hand","face_hurt","face_daze","shards"],"events":{"hit":400,"hit_big":700,"attack":800,"daze":600,"die":1000,"refuse":300},"desc":"画像（第二、三幕小怪）：一幅旧油画自己站了起来。厚厚的旧金画框（frame，压暗的旧金，不发光），画框下面伸出两条细细的弯木腿（legs）站在地上；画布（canvas）是深色底，画里是一位戴高领的老夫人半身像（figure），眼睛（eyes）会转，一只手（hand）捏着一把小银叉，翘着小指，一脸嫌弃。规矩\"挑食\"：只带一颗宝石的牌打它算 0。refuse（300，挑食生效时播）：画里的老夫人把头一扭，拿叉子的手往外一推","artStyle":"fable-carbon-remake","idle":true}
