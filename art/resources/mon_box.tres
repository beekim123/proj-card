script = ExtResource("1")
art_id = "mon_box"
svg_fingerprint = "3a3936e3f44a9004"
definition = {"group":"怪","viewBox":"0 0 320 400","load":"inline","monster":"normal","anchor":[160,400],"stay":["daze"],"status":"新画法重制","id":"mon_box","hitPoint":[160,200],"batch":"本体第2批","parts":["root","shadow","box","lid","crank","spring","head","eyes","face_hurt","face_daze","bits"],"events":{"hit":400,"hit_big":700,"attack":800,"daze":600,"die":1000,"duck":300},"desc":"弹簧盒（第二、三幕小怪）：一只旧玩具弹簧盒。方木盒（box）漆面剥落，四角包铁；盒盖（lid）掀开立在后面；侧面一根摇柄（crank）；盒里一根粗弹簧（spring）顶着一颗布做的圆脑袋（head），戴一顶尖尖的旧布帽，两只纽扣眼睛（eyes），嘴是一道缝线，咧着笑。诡萌，不吓人，不要画成恐怖小丑。规矩\"缩头\"：每回合你打的第 2、4、6…张牌打不着它。duck（300，打不着时播）：脑袋猛地缩进盒子，盒盖啪地扣上，再弹出来","idle":true,"production_note":"画法、时间点与静态例外以本包需求.md/制作规范.md/动作时间表.json为准。","artStyle":"fable-carbon-remake"}
