definition = {"id":"card_art_hourglass","group":"额外牌原画","viewBox":"0 0 176 188","load":"inline","events":{"play":600},"desc":"沙漏（怪出手推后 1 回合）：一只旧铜架沙漏，里面流的不是沙，是青色的小宝石碎粒（青 = 绿 + 蓝）。上半截还剩一大半。待机：碎粒一粒一粒往下掉，上下两堆的高度不变。play：整只一震、停流，然后一串碎粒从下半截倒着飞回上半截，上面那堆明显长高一截，闪一下青光，再回到待机的高度。要一眼看出\"时间倒回去了一点\"","status":"新画法重制","batch":"本体第1批","idle":true,"production_note":"画法、时间点与静态例外以本包需求.md/制作规范.md/动作时间表.json为准。","artStyle":"fable-carbon-remake"}
