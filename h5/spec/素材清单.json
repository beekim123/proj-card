{
  "name": "新卡牌 第一版 demo · 素材清单（代码和美术共用）",
  "codename": "gemcard",
  "version": 1,
  "date": "2026-11-09",
  "about": "美术按这份交 SVG，代码按这份读 SVG。素材竖屏、横屏共用，两种布局只是摆的位置不同，素材本身不改。id 就是文件名：out/<id>.svg。",

  "fields": {
    "id": "文件名，也是代码里找素材用的名字",
    "phase": "第几批交：1 = 能玩起来必须有的，2 = 补齐",
    "viewBox": "SVG 的 viewBox；同时也是 SVG 根上 width/height 的值",
    "load": "img = 代码用 <img> 显示（静态，不能有事件）；inline = 代码把 SVG 塞进页面（有事件或要染色的）",
    "events": "事件名: 毫秒。代码设 data-anim=\"事件名\" 播一次，到时间后去掉",
    "tint": "true = 图里用 currentColor 的部分由代码按这张牌的混色染色",
    "nineSlice": "九宫格：[上, 右, 下, 左] 四条切线离边的距离；角不拉伸，边和中间会被拉长",
    "anchor": "这个点对齐到布局里给的位置（一般是底边中点）",
    "parts": "必须有的 <g id>"
  },

  "palette": {
    "about": "界面上代码自己画的东西（字、进度条、标签）只用这些颜色。宝石色是唯一的饱和色。",
    "ink": "#1C1412",
    "text": "#E6DEC8",
    "textDim": "#9A8968",
    "accent": "#C2A670",
    "accentDark": "#6E542B",
    "pageBg": "#0D111C",
    "panelBg": "#161221",
    "barTrack": "#262036",
    "barFill": "#C2A670",
    "gem": {
      "red":   { "name": "红宝石", "bit": 1, "shape": "圆形",   "mid": "#E3263A" },
      "green": { "name": "绿宝石", "bit": 2, "shape": "方形",   "mid": "#1DBF5E" },
      "blue":  { "name": "蓝宝石", "bit": 4, "shape": "三角形", "mid": "#2E66F0" }
    },
    "mix": {
      "about": "牌的混色：原画窗里宝石后面的光、特效染色都用它。key 是宝石位（红 1 绿 2 蓝 4 相加）",
      "1": "#E3263A",
      "2": "#1DBF5E",
      "4": "#2E66F0",
      "3": "#FFD84A",
      "6": "#3FE3F0",
      "5": "#E94FD8",
      "7": "#F4F1FF",
      "0": null
    }
  },

  "cardLayout": {
    "about": "一张牌的坐标，单位是牌面单位（整张 200×300）。桌面上显示 0.75 倍（150×225），手牌 1.4 倍（280×420），点开放大 2 倍。从下往上叠：card_frame 下面是原画窗内容，见 order。",
    "size": [200, 300],
    "order": ["card_art_bg", "混色光（代码画）", "宝石 或 card_art_empty", "card_frame（原画窗挖空）", "card_gem_bar", "宝石栏里的 gem_icon", "左上角 gem_icon", "文字（代码写）"],
    "artWindow": { "x": 12, "y": 12, "w": 176, "h": 188, "r": 8, "about": "card_frame 在这里是透明的洞；card_art_bg、card_art_empty 正好铺满这个窗" },
    "glow": { "cx": 88, "cy": 96, "r": 84, "opacity": 0.5, "about": "原画窗坐标。径向渐变，中心是混色，边缘透明。黑牌没有光" },
    "gems": {
      "about": "原画窗坐标（窗左上角是 0,0）。[中心x, 中心y, 显示边长]。宝石素材是 100×100，按边长缩放。每颗宝石按它自己现在的形态显示",
      "1": [[88, 96, 100]],
      "2": [[66, 104, 80], [118, 90, 80]],
      "2_order": "两颗时左边放位小的：红+绿 红左绿右；绿+蓝 绿左蓝右；红+蓝 红左蓝右",
      "3": { "green": [88, 58, 72], "red": [52, 128, 72], "blue": [124, 128, 72] }
    },
    "gemBar": { "x": 34, "y": 186, "w": 132, "h": 34, "sockets": { "red": [64, 203], "green": [100, 203], "blue": [136, 203] }, "iconSize": 24, "about": "socket 是牌面坐标。有这颗宝石就在 socket 上放 gem_icon，没有就露出栏上的空槽" },
    "corner": { "red": [28, 32], "green": [28, 60], "blue": [28, 88], "iconSize": 24, "about": "左上角竖排，只放这张牌有的宝石，位置固定（没有的那格空着）" },
    "text": {
      "name":  { "x": 18,  "y": 250, "size": 24, "weight": 700, "align": "left",  "color": "text" },
      "value": { "x": 182, "y": 250, "size": 24, "weight": 700, "align": "right", "color": "accent" },
      "line":  { "x": 18,  "y": 278, "size": 20, "minSize": 16, "maxWidth": 164, "align": "left", "color": "textDim", "about": "基础牌写底数组成，如「红 150 + 绿 100」；放不下先改成紧凑写法「红150+绿100+蓝200」，再缩字号，最小 16" },
      "about": "y 是文字基线"
    }
  },

  "assets": [
    { "id": "card_frame", "phase": 1, "group": "卡牌", "viewBox": "0 0 200 300", "load": "img",
      "desc": "牌框：整张牌的外框和下半截文字框的底。原画窗（cardLayout.artWindow）必须是透明的洞，框可以压住窗边 2–6。不画任何字和宝石" },
    { "id": "card_art_bg", "phase": 1, "group": "卡牌", "viewBox": "0 0 176 188", "load": "img",
      "desc": "原画窗底：放宝石的暗色衬底（比如旧丝绒、首饰盒内衬），中间空出来给宝石，不要抢眼" },
    { "id": "card_art_empty", "phase": 1, "group": "卡牌", "viewBox": "0 0 176 188", "load": "img",
      "desc": "空托（黑牌的原画）：叠在 card_art_bg 上面，一个空的宝石托，三个爪子空着，没有宝石。不发光" },
    { "id": "card_gem_bar", "phase": 1, "group": "卡牌", "viewBox": "0 0 132 34", "load": "img",
      "desc": "宝石栏：一条金属条，上面三个空槽，从左到右是圆槽、方槽、三角槽，槽中心在栏坐标 (30,17) (66,17) (102,17)，槽大小能放下 24 的小图标" },

    { "id": "gem_red_rough",    "phase": 1, "group": "宝石", "viewBox": "0 0 100 100", "load": "img", "desc": "红宝石 · 原石（圆）" },
