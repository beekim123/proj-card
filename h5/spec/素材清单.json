    { "id": "gem_blue_rough",   "phase": 1, "group": "宝石", "viewBox": "0 0 100 100", "load": "img", "desc": "蓝宝石 · 原石（三角）" },
    { "id": "gem_blue_cut",     "phase": 1, "group": "宝石", "viewBox": "0 0 100 100", "load": "img", "desc": "蓝宝石 · 切好（三角）" },
    { "id": "gem_blue_shine",   "phase": 1, "group": "宝石", "viewBox": "0 0 100 100", "load": "img", "desc": "蓝宝石 · 闪光（三角）" },

    { "id": "gem_icon_red",   "phase": 1, "group": "宝石小图标", "viewBox": "0 0 32 32", "load": "img", "desc": "红宝石小图标（圆），显示 18–34，只看颜色和形状" },
    { "id": "gem_icon_green", "phase": 1, "group": "宝石小图标", "viewBox": "0 0 32 32", "load": "img", "desc": "绿宝石小图标（方）" },
    { "id": "gem_icon_blue",  "phase": 1, "group": "宝石小图标", "viewBox": "0 0 32 32", "load": "img", "desc": "蓝宝石小图标（三角）" },

    { "id": "dummy", "phase": 1, "group": "敌人", "viewBox": "0 0 300 384", "load": "inline", "anchor": [150, 384],
      "parts": ["root", "shadow", "post", "body", "target", "head", "face", "face_hurt", "straw_fly"],
      "events": { "hit": 400, "hit_big": 700 },
      "desc": "练习木桩：插在地上的木桩 + 横木当手臂 + 麻布袋脑袋，胸口画着靶子。idle 像被线吊着轻晃；hit 被打一下往后一歪再回来；hit_big 重击，歪得更狠，换 face_hurt，草屑 straw_fly 飞出来。木桩不会死，不倒地" },
    { "id": "table_cloth", "phase": 1, "group": "牌桌", "viewBox": "0 0 256 256", "load": "img", "nineSlice": [72, 72, 72, 72],
      "desc": "桌面排的桌布：暗色绒布 + 四角包铜。会被拉成 1032×330（竖屏）和 1248×330（横屏），角里的花纹不能超过切线" },

    { "id": "bg_tile", "phase": 2, "group": "背景", "viewBox": "0 0 512 512", "load": "img",
      "desc": "整屏背景，可以无缝平铺：练习场的暗石墙或旧墙纸。很暗、很平，不画具体东西，代码会再压暗边缘" },
    { "id": "prop_rack", "phase": 2, "group": "场景", "viewBox": "0 0 120 240", "load": "img", "anchor": [60, 240],
      "desc": "木桩旁边的兵器架，插着两三把练习用的木剑木棍。表示这里是练习场。不发光" },

    { "id": "ui_panel", "phase": 2, "group": "界面", "viewBox": "0 0 192 192", "load": "img", "nineSlice": [48, 48, 48, 48],
      "desc": "通用底板：顶栏、宝石成长条、弹窗都用它。代码会按 24–48 的边宽显示（小的条子用 24），所以角花缩到一半也要好看" },
    { "id": "ui_btn", "phase": 2, "group": "界面", "viewBox": "0 0 192 96", "load": "img", "nineSlice": [32, 32, 32, 32],
      "desc": "普通按钮底（撤回、牌库）。按下、不能点的样子由代码做（压暗、下沉、变灰）" },
    { "id": "ui_btn_primary", "phase": 2, "group": "界面", "viewBox": "0 0 192 96", "load": "img", "nineSlice": [32, 32, 32, 32],
      "desc": "主按钮底（结束回合）：比 ui_btn 醒目，旧铜色" },
    { "id": "ui_mult_badge", "phase": 2, "group": "界面", "viewBox": "0 0 220 100", "load": "inline",
      "events": { "up": 300, "double": 600 },
      "desc": "倍率牌子：一块小铜牌，中间空着给代码写「×48」。up = 倍率 +1，一道光扫过；double = 倍率翻倍，边上迸几颗火星。整体弹一下由代码做，事件里只做牌子自己的光和火星，不要缩放整个 root" },
    { "id": "ui_icon_rules",    "phase": 2, "group": "图标", "viewBox": "0 0 64 64", "load": "img", "desc": "规则（一本旧书 / 一卷纸）" },
    { "id": "ui_icon_settings", "phase": 2, "group": "图标", "viewBox": "0 0 64 64", "load": "img", "desc": "设置（齿轮或钥匙）" },
    { "id": "ui_icon_undo",     "phase": 2, "group": "图标", "viewBox": "0 0 64 64", "load": "img", "desc": "撤回（往回弯的箭头）" },
    { "id": "ui_icon_deck",     "phase": 2, "group": "图标", "viewBox": "0 0 64 64", "load": "img", "desc": "牌库（一叠牌背）" },

    { "id": "fx_hit",     "phase": 2, "group": "特效", "viewBox": "0 0 160 160", "load": "inline", "tint": true, "events": { "play": 400 },
