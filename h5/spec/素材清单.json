    { "id": "fx_white",   "phase": 2, "group": "特效", "viewBox": "0 0 240 240", "load": "inline", "events": { "play": 700 },
      "desc": "凑白：一团白光炸开（不染色）" },
    { "id": "fx_rainbow", "phase": 2, "group": "特效", "viewBox": "0 0 400 160", "load": "inline", "events": { "play": 800 },
      "desc": "彩虹：一道六色的弧从左到右划过（红、黄、绿、青、蓝、品红，用 palette.mix 的颜色），划完散成碎光" },
    { "id": "fx_grow",    "phase": 2, "group": "特效", "viewBox": "0 0 160 160", "load": "inline", "tint": true, "events": { "play": 800 },
